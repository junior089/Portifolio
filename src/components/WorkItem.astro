---
import type { Link } from '../data/types';

interface Props {
  n: string;
  name: string;
  title: string;
  desc: string;
  status: string;
  meta: string;
  href: string;
  viewSource?: string;
  links?: Link[];
  readCaseLabel: string;
  viewSourceLabel: string;
}

const { n, name, title, desc, status, meta, href, viewSource, links = [], readCaseLabel, viewSourceLabel } = Astro.props;
---

<li class="relative border-t border-line py-12 transition-colors has-[a:hover]:bg-surface">
  <div class="flex flex-wrap items-baseline gap-[clamp(24px,5vw,56px)]">
    <div class="min-w-6 font-mono text-xs text-muted">{n}</div>
    <div class="min-w-[260px] max-w-[760px] flex-1">
      <div class="mb-3 font-mono text-xs text-bone">{name}</div>
      <h2 class="mb-4 text-title font-serif text-paper text-pretty">
        <a href={href} class="static after:absolute after:inset-0">{title}</a>
      </h2>
      <p class="mb-5 max-w-[680px] text-lg text-muted text-pretty">{desc}</p>
      <div class="mb-3 font-mono text-xs text-paper">{status}</div>
      <div class="font-mono text-xs leading-[1.8] text-muted">{meta}</div>
    </div>
    <div class="flex flex-col items-end gap-3 font-mono text-xs">
      <span class="text-bone">{readCaseLabel}</span>
      {
        links.map((l) => (
          <a href={l.href} target="_blank" rel="noreferrer" class="relative z-10 text-muted hover:text-paper">
            {l.label}
          </a>
        ))
      }
      {
        viewSource && (
          <a href={viewSource} target="_blank" rel="noreferrer" class="relative z-10 text-muted hover:text-paper">
            {viewSourceLabel}
          </a>
        )
      }
    </div>
  </div>
</li>
